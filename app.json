{
  "expo": {
    "name": "TradeGuard",
    "slug": "tradeguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0e1a",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0e1a"
      },
      "package": "com.srinigai.tradeguard",
      "versionCode": 1,
      "permissions": ["NOTIFICATIONS", "INTERNET", "VIBRATE", "RECEIVE_BOOT_COMPLETED"]
    },
    "plugins": [
      ["expo-notifications", {
        "icon": "./assets/icon.png",
        "color": "#00d4aa"
      }],
      "expo-font"
    ]
  }
}
